# Copia este archivo a ~/.env.moyaops en el servidor y rellena los valores

DEBUG=False
SECRET_KEY=cambia-esto-por-una-clave-segura

# Hosts permitidos (separados por coma, sin espacios)
ALLOWED_HOSTS=moyaops.com,www.moyaops.com,moyaopsapp

# Base de datos — usa el mismo contenedor Postgres que app_servicios
POSTGRES_HOST=app_postgres
POSTGRES_DB=moyaops_site
POSTGRES_USER=app_user
POSTGRES_PASSWORD=la-misma-contrasena-del-postgres
POSTGRES_PORT=5432

# HTTPS (True si el bastión gestiona TLS)
HTTPS=True
